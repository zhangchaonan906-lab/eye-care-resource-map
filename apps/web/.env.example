# Copy to .env.local for local development. Keep all values local and uncommitted.
# Server-only Web runtime URLs. Never prefix DB/admin credentials with NEXT_PUBLIC_.
PUBLIC_API_DATABASE_URL=postgresql://eye_public_api_runtime:REPLACE_WITH_LOCAL_SECRET@127.0.0.1:55432/eye
ADMIN_DATABASE_URL=postgresql://eye_admin_review_runtime:REPLACE_WITH_LOCAL_SECRET@127.0.0.1:55432/eye
CORRECTION_DATABASE_URL=postgresql://eye_correction_runtime:REPLACE_WITH_LOCAL_SECRET@127.0.0.1:55432/eye
# Shared production/staging request limiter. Never use a process-local fallback there.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Enable only when the deployment proxy overwrites these headers with the actual client address.
TRUST_PROXY_HEADERS=false
RATE_LIMIT_HASH_SECRET=REPLACE_WITH_RANDOM_32_BYTE_SECRET
# Admin application identity. Use a strong hash and random session secret.
ADMIN_USERNAME=REPLACE_WITH_LOCAL_USERNAME
ADMIN_PASSWORD_HASH=REPLACE_WITH_SCRYPT_HASH
ADMIN_SESSION_SECRET=REPLACE_WITH_RANDOM_32_BYTE_SECRET
ADMIN_ACTOR_ID=REPLACE_WITH_UUID

# Public canonical origin. Leave unset locally unless testing canonical metadata.
SITE_URL=
APP_ENV=local
RELEASE_COMMIT_SHA=
BUILD_TIMESTAMP=
