# Use a dedicated database login granted the eye_collector role.
DATABASE_URL=postgresql://eye_collector:replace-me@localhost:55432/eye
# Use a separate login granted only the eye_geocode role.
GEOCODE_DATABASE_URL=postgresql://eye_geocode_runtime:replace-me@localhost:55432/eye
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RESPONSE_BYTES=1048576
HTTP_MAX_ATTEMPTS=4
HTTP_BACKOFF_BASE_SECONDS=0.25
HTTP_USER_AGENT=eye-care-resource-collector/0.1 (+https://github.com/zhangchaonan906-lab/eye-care-resource-map)
