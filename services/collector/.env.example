# Use a dedicated database login granted the eye_collector role.
DATABASE_URL=postgresql://eye_collector:replace-me@localhost:55432/eye
# Use a separate login granted only the eye_geocode role.
GEOCODE_DATABASE_URL=postgresql://eye_geocode_runtime:replace-me@localhost:55432/eye
# Separate credentials: scheduler/worker can only execute P12 sync functions.
SYNC_DATABASE_URL=postgresql://eye_sync_worker_runtime:replace-me@localhost:55432/eye
ETL_DATABASE_URL=postgresql://eye_etl_runtime:replace-me@localhost:55432/eye
WORKER_ID=local-sync-worker
WORKER_POLL_SECONDS=5
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RESPONSE_BYTES=1048576
HTTP_MAX_ATTEMPTS=4
HTTP_BACKOFF_BASE_SECONDS=0.25
HTTP_USER_AGENT=eye-care-resource-collector/0.1 (+https://github.com/zhangchaonan906-lab/eye-care-resource-map)
# Intentionally unset/false for normal development. Real pilot commands also
# require an approved source adapter and an explicit positive --limit.
PILOT_REAL_DATA=false
